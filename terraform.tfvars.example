# Copy to terraform.tfvars. Set identifiers for your own disposable demo account.
# Recommended across accounts: set this token alongside the matching account_id
# and zone_id in the gitignored terraform.tfvars. No shell export is required.
# Alternative: leave it empty and export CLOUDFLARE_API_TOKEN in the Terraform shell.
# A non-empty tfvars value takes precedence; do not set both.
# Never commit the real terraform.tfvars or a saved plan containing credentials.
cloudflare_api_token = ""
account_id         = ""
zone_id            = ""
ai_gateway_id      = "terraform-cloudflare-one-demo"
allowed_user_emails_file = "files/allowed-user-emails.local.txt"
egress_emails_file       = "files/egress-emails.local.txt"
# Microsoft Entra ID app registration used by the Access applications.
# Keep the real secret only in ignored terraform.tfvars or inject it as
# TF_VAR_entra_client_secret from a secret manager.
entra_client_id     = ""
entra_client_secret = ""
entra_directory_id  = ""
# entra_idp_name    = "Microsoft Entra ID"

# Optional Clientless Web Isolation (RBI) tile in the Access App Launcher.
# Requires the Browser Isolation add-on. Obtain the exact team name from the
# Zero Trust dashboard; leave the URL empty to skip this resource.
access_team_name       = ""
rbi_bookmark_name      = "Remote Browser"
rbi_bookmark_url       = ""
# Example: "https://<team-name>.cloudflareaccess.com/browser/https://example.com"
