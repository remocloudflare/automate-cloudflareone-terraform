        <mxCell id="subtitle" value="Two paths: Terraform reconciles configuration; an authenticated client proves tool access." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=16;fontColor=#A8B3C7;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="72" y="80" width="1300" height="34" as="geometry"/></mxCell>
